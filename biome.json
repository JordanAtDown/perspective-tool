{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!package-lock.json", "!.claude"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "css": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "overrides": [{ "includes": ["tests/**"], "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } } }],
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
