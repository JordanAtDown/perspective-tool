# Vérifie que la première ligne du message suit les Conventional Commits :
#   type(portée optionnelle): description
# Exemples : "feat: ajouter l'export PNG", "fix(pdf): corriger la longueur du flux"
msg_file="$1"
subject=$(head -n 1 "$msg_file")

# Messages générés par git : on les laisse passer.
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

types="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
if ! printf '%s' "$subject" | grep -Eq "^($types)(\([a-z0-9-]+\))?!?: .+"; then
  echo "Message de commit refusé : « $subject »" >&2
  echo "Format attendu : type(portée): description" >&2
  echo "Types : feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert" >&2
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  echo "Première ligne trop longue (${#subject} caractères, 72 maximum)." >&2
  exit 1
fi
